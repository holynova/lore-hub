{
  // NOTE: the Worker is deployed under the reused name "elden-ring-lore",
  // not "lore-hub": the account is on the Workers Free plan (100 Worker
  // cap) and already has 136 Workers, so a new Worker cannot be created
  // (error 10037). The name is only an internal label; the Worker serves
  // lore.xiaosang.cc plus 301s for the 7 old hosts. After upgrading to
  // Workers Paid, rename this to "lore-hub" and re-deploy, then move the
  // 8 routes to the new Worker.
  "name": "elden-ring-lore",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "routes": [
    {
      "pattern": "lore.xiaosang.cc/*",
      "zone_name": "xiaosang.cc"
    }
  ],
  "main": "./worker/media.mjs"
}
